     /* ---------- surface finish per system (roughness, clearcoat, sheen) ---------- */
+    /* ---------- reference lines ---------- */
+    // planes: sagittal blue, coronal amber, transverse violet
+    function refPlaneColor(n) {
+      n = n.toLowerCase();
+      return /median|sagittal/.test(n) ? 0x4aa3f0 : /coronal/.test(n) ? 0xffb347 : /transverse/.test(n) ? 0xb48cff : 0x9aa0a6;
+    }
+    // surface lines: midline yellow, axillary teal, back lines violet, the rest of the front lines orange
+    function refLineColor(n) {
+      n = n.toLowerCase();
+      return /median/.test(n) ? 0xffd24a : /axillary/.test(n) ? 0x3fd0c9 : /paravertebral|scapular/.test(n) ? 0xb36bff : 0xff9f43;
+    }
+    // The model draws each surface line as a ribbon standing on the skin, a fraction of a millimetre thick, so seen from the
+    // front it is edge-on and all but invisible. Rebuild it as a thin tube along the ribbon's centre line.
+    function ribbonToTube(geo, radius) {
+      const pos = geo.attributes.position;
+      const box = new THREE.Box3().setFromBufferAttribute(pos);
+      const size = box.getSize(new THREE.Vector3());
+      const axis = size.y >= size.x && size.y >= size.z ? 'y' : size.z >= size.x ? 'z' : 'x';
+      const span = size[axis];
+      if (!(span > 1e-4)) return geo;
+      const bins = Math.max(6, Math.min(48, Math.round(span / 0.006)));   // one centre point about every 6 mm
+      const sums = Array.from({ length: bins }, () => [0, 0, 0, 0]);
+      const v = new THREE.Vector3();
+      for (let i = 0; i < pos.count; i++) {
+        v.fromBufferAttribute(pos, i);
+        const a = sums[Math.min(bins - 1, Math.floor(((v[axis] - box.min[axis]) / span) * bins))];
+        a[0] += v.x; a[1] += v.y; a[2] += v.z; a[3]++;
+      }
+      const pts = sums.filter(a => a[3]).map(a => new THREE.Vector3(a[0] / a[3], a[1] / a[3], a[2] / a[3]));
+      if (pts.length < 2) return geo;
+      const tube = new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts, false, 'centripetal'), Math.max(12, pts.length * 3), radius, 6, false);
+      geo.dispose();
+      return tube;
+    }
+
