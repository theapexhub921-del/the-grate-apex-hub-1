; Engine configuration file.
config_version=5

[application]

config/name="Med Term Scramble"
config/description="Competitive medical terminology word-scramble game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.0784, 0.0627, 0.1176, 1)
boot_splash/show_image=false

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
SaveData="*res://scripts/autoload/save_data.gd"
Style="*res://scripts/autoload/style.gd"
Audio="*res://scripts/autoload/audio.gd"
Net="*res://scripts/autoload/net.gd"
Router="*res://scripts/autoload/router.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=780
window/size/window_width_override=1100
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
