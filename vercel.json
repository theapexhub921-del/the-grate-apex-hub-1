{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/assemble-games.mjs && npx expo export --platform web && cp dist/+not-found.html dist/404.html && rm -f dist/game-builds/*/*.part*",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://grate-apex.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://grate-apex.firebaseapp.com/__/firebase/init.json"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/leagues",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/leagues?retry=1",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "api/reminders.mjs": {
      "maxDuration": 60
    },
    "api/delete-account.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/atlas/(.*)\\.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/atlas/anatomy(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
